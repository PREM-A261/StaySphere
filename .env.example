# MongoDB Connection URL (Local or MongoDB Atlas)
ATLASDB_URL=mongodb://127.0.0.1:27017/staysphere
# Or MongoDB Atlas:
# ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/staysphere?retryWrites=true&w=majority

# Express Session Secret
SECRET=your_super_secret_session_key

# Cloudinary Credentials (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Token (for interactive maps and geocoding)
MAP_TOKEN=your_mapbox_public_token

# Port (Optional, default 8080)
PORT=8080
